{
  "name": "@cagase/dsh-cursor",
  "version": "0.0.1",
  "description": "DeepSeek Harness plugin: use a Cursor workspace (skills, rules, hooks, MCP) and the Cursor agent CLI as picker + AgentTeams model routes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cagase/dsh-cursor.git"
  },
  "homepage": "https://github.com/cagase/dsh-cursor#readme",
  "bugs": {
    "url": "https://github.com/cagase/dsh-cursor/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-mcp-client": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-skill": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.1.5-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cursor",
    "plugin"
  ]
}
